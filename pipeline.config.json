{
  "project": "pipeline-sandbox",
  "pack": "generic",
  "admins": [
    "brianm-di4u"
  ],
  "trustedBots": [
    "dependabot[bot]"
  ],
  "verify": {
    "fast": "node --test tests/",
    "full": "node --test tests/",
    "e2e": "node --test tests/",
    "checkNames": [
      "verify"
    ]
  },
  "tiers": {
    "t0Paths": [
      "docs/**/*.md",
      "README.md",
      "CHANGELOG.md"
    ],
    "t0Exclude": [
      "docs/decisions/**",
      "docs/PRD.md",
      "docs/THREAT-MODEL.md"
    ],
    "t2Paths": [],
    "decisionPaths": [
      "docs/decisions/**"
    ],
    "sizeWarnLines": 800
  },
  "merge": {
    "t0": "auto",
    "t1": "auto",
    "t2": "auto"
  },
  "council": {
    "maxRounds": 3,
    "maxRoundsSensitive": 5,
    "maxNits": 5,
    "maxSeats": 6,
    "maxDiffGrowth": 1.5,
    "externalSeats": []
  },
  "breaker": {
    "window": 20,
    "maxFailures": 3
  },
  "autopilot": {
    "maxPrsPerDay": 5,
    "maxConsecutiveFailures": 2
  },
  "formatters": {}
}
